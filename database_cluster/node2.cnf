[mysqld]
# Node identity: mysql2

server_id=102
report_host=mysql2

# Group Replication communication. loose- prefix required: see base.cnf.
loose-group_replication_local_address=mysql2:33061
loose-group_replication_group_seeds=mysql1:33061,mysql2:33061,mysql3:33061

# Pin relay-log names so replication survives hostname changes (MY-010604)
relay_log=mysql2-relay-bin
