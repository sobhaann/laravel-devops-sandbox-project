# Shared configuration for every node of the InnoDB Cluster.
# Reference: https://dev.mysql.com/doc/refman/8.0/en/group-replication-requirements.html

[mysqld]

# Load Group Replication at startup so group_replication_* options are valid
# (prevents "unknown variable" warnings; the AdminAPI then controls the plugin).
plugin-load-add = group_replication.so

# --- Replication prerequisites ---------------------------------------------
gtid_mode                = ON
enforce_gtid_consistency = ON
log_bin                  = binlog
log_replica_updates      = ON
relay_log                = relay-bin

# The AdminAPI decides when the group is started (START GROUP_REPLICATION);
# never auto-start on boot, otherwise mysqld fails with
# "group_replication_group_name option is mandatory".
#
# NOTE: group_replication_* options MUST use the "loose-" prefix here: during
# first-time initialization (--initialize-insecure) the plugin is not loaded
# yet, and an unknown option would make initialization FAIL outright.
loose-group_replication_start_on_boot = OFF

# Placeholder; each node overrides it on the command line (--server-id=10x).
server_id                = 1

# Storage engines that cannot be used together with Group Replication.
disabled_storage_engines = "MyISAM,BLACKHOLE,FEDERATED,ARCHIVE"

# Notes:
# * binlog_checksum / super_read_only are validated and persisted automatically
#   by dba.configureInstance() in database_cluster/init-cluster.js.
# * transaction_write_set_extraction (deprecated 8.0.26) and
#   binlog_transaction_dependency_tracking (deprecated 8.0.35) are intentionally
#   NOT set - their defaults are correct for modern Group Replication.
